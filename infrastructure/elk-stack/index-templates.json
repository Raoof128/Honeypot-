{
  "templates": [
    {
      "name": "honeypot-logs-template",
      "description": "Index template for all honeypot logs with optimized field mappings and lifecycle policies",
      "index_patterns": ["honeypot-*"],
      "priority": 100,
      "template": {
        "settings": {
          "index": {
            "number_of_shards": 1,
            "number_of_replicas": 0,
            "refresh_interval": "5s",
            "codec": "best_compression",
            "max_result_window": 10000,
            "lifecycle": {
              "name": "honeypot-lifecycle-policy",
              "rollover_alias": "honeypot"
            }
          },
          "analysis": {
            "analyzer": {
              "lowercase_analyzer": {
                "type": "custom",
                "tokenizer": "keyword",
                "filter": ["lowercase"]
              }
            }
          }
        },
        "mappings": {
          "dynamic": "true",
          "dynamic_date_formats": [
            "strict_date_optional_time",
            "yyyy/MM/dd HH:mm:ss||yyyy/MM/dd||epoch_millis"
          ],
          "properties": {
            "@timestamp": {
              "type": "date",
              "format": "strict_date_optional_time||epoch_millis"
            },
            "@version": {
              "type": "keyword"
            },
            "event_type": {
              "type": "keyword"
            },
            "honeypot_type": {
              "type": "keyword"
            },
            "attacker_ip": {
              "type": "ip"
            },
            "source_ip": {
              "type": "ip"
            },
            "destination_ip": {
              "type": "ip"
            },
            "source_port": {
              "type": "integer"
            },
            "destination_port": {
              "type": "integer"
            },
            "protocol": {
              "type": "keyword"
            },
            "session_id": {
              "type": "keyword"
            },
            "username": {
              "type": "keyword",
              "fields": {
                "text": {
                  "type": "text"
                }
              }
            },
            "password": {
              "type": "keyword",
              "fields": {
                "text": {
                  "type": "text"
                }
              }
            },
            "command": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "url": {
              "type": "keyword",
              "fields": {
                "text": {
                  "type": "text"
                }
              }
            },
            "domain": {
              "type": "keyword",
              "fields": {
                "text": {
                  "type": "text"
                }
              }
            },
            "file_hash": {
              "type": "keyword"
            },
            "md5": {
              "type": "keyword"
            },
            "sha1": {
              "type": "keyword"
            },
            "sha256": {
              "type": "keyword"
            },
            "filename": {
              "type": "keyword",
              "fields": {
                "text": {
                  "type": "text"
                }
              }
            },
            "threat_score": {
              "type": "integer"
            },
            "confidence": {
              "type": "float"
            },
            "success": {
              "type": "boolean"
            },
            "severity": {
              "type": "keyword"
            },
            "mitre_technique": {
              "type": "keyword"
            },
            "mitre_tactic": {
              "type": "keyword"
            },
            "mitre_technique_name": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword"
                }
              }
            },
            "geoip": {
              "properties": {
                "continent_name": {
                  "type": "keyword"
                },
                "country_name": {
                  "type": "keyword"
                },
                "country_code2": {
                  "type": "keyword"
                },
                "country_code3": {
                  "type": "keyword"
                },
                "region_name": {
                  "type": "keyword"
                },
                "region_code": {
                  "type": "keyword"
                },
                "city_name": {
                  "type": "keyword"
                },
                "postal_code": {
                  "type": "keyword"
                },
                "latitude": {
                  "type": "float"
                },
                "longitude": {
                  "type": "float"
                },
                "location": {
                  "type": "geo_point"
                },
                "timezone": {
                  "type": "keyword"
                },
                "asn": {
                  "type": "keyword"
                },
                "as_org": {
                  "type": "keyword",
                  "fields": {
                    "text": {
                      "type": "text"
                    }
                  }
                }
              }
            },
            "message": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 1024
                }
              }
            },
            "raw_message": {
              "type": "text",
              "index": false
            },
            "log": {
              "properties": {
                "file": {
                  "properties": {
                    "path": {
                      "type": "keyword"
                    }
                  }
                }
              }
            },
            "host": {
              "properties": {
                "name": {
                  "type": "keyword"
                },
                "ip": {
                  "type": "ip"
                }
              }
            },
            "tags": {
              "type": "keyword"
            }
          }
        }
      }
    },
